          <view floating="true" left="0" top="0" width="60" height="60" rotate="{{e3}}deg">
            <view floating="true" left="29" top="0" width="31" height="60"><view floating="true" left="-27" top="2" width="56" height="56" radius="28" border-width="5" border-color="{{u3}}" /></view>
          </view>
