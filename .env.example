# 云端服务的配置：复制成仓库根目录的 .env，deploy/compose.yaml 读它。
# Token 用一长串随机字符，比如 openssl rand -hex 24 生成。

# 平台 Agent 插件的 Bearer Token，平台连 /claude/agent 时带上
GLASSCLAUDE_AGENT_TOKEN=
# Mac 上桥接程序的 Token，连 /claude/bridge 时带上。Mac 上的 ~/.config/glassclaude/env 填同一个
GLASSCLAUDE_BRIDGE_TOKEN=
# 允许的眼镜，逗号分隔。第一次连上后，从容器日志“眼镜会话 ...：设备 '...'”里抄引号里那串。
# 留空的话，任何连到这个服务的眼镜都能往你的 Claude 会话里发指令
GLASSCLAUDE_ALLOWED_DEVICES=
# 服务重启后平台重连时可能不带页面列表，这时用这个页面。从容器日志“用页面 ...”里抄，可以不填
GLASSCLAUDE_TEMPLATE_ID=

# 音频流插件的语音识别：OpenAI GA 版 Realtime 的转写会话（intent=transcription），地址里带上 model。
# 插件选「ASR文本」的话不用填。例子（AxonHub 网关转百炼 Paraformer，只收 24 kHz，服务会自己升采样）：
# GLASSCLAUDE_ASR_URL=wss://gateway.example.com/v1/realtime?intent=transcription&model=paraformer-realtime-v2
GLASSCLAUDE_ASR_URL=
GLASSCLAUDE_ASR_KEY=
# 识别语言，默认 zh
# GLASSCLAUDE_ASR_LANGUAGE=zh
# 判断开口的响度门限，周围吵、老是误识别就调大，默认 400
# GLASSCLAUDE_ASR_GATE=400

# Mac 上的 ~/.config/glassclaude/env（权限 600）只要这两行，不放在这个文件里：
# GLASSCLAUDE_CLOUD=wss://example.com/claude/bridge
# GLASSCLAUDE_BRIDGE_TOKEN=和上面同一个
